// Banco de dados do Unlimited (PostgreSQL).
//
//   Configuracao  -> preco e peso do rolo, margem (uma linha so, id = 1)
//   Calculo       -> cada calculo de filamento feito na calculadora
//   Impresso      -> cada lote de pecas realmente impresso (custo x venda)
//   Local         -> lugares onde as pecas boas ficam
//   Movimento     -> pecas de um lote levadas de um local pra outro
//   Kit           -> produto montado com pecas de varios lotes (ex.: suporte + chaveiros)
//   KitItem       -> pecas de um lote que foram pra dentro de um kit

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Configuracao {
  id           Int      @id @default(1)
  precoRolo    Float    @default(120)
  pesoRoloG    Float    @default(1000)
  margemPct    Float    @default(0)
  atualizadoEm DateTime @updatedAt
}

model Calculo {
  id             String     @id @default(cuid())
  criadoEm       DateTime   @default(now())
  origem         String     @default("makerworld") // makerworld | manual
  titulo         String
  link           String     @default("")
  idModelo       Int?
  idPerfil       Int?
  perfil         String     @default("")
  placas         Int        @default(0)
  segundos       Int        @default(0)
  pecas          Int        @default(1)
  escalaPct      Float      @default(100)
  precoRolo      Float
  pesoRoloG      Float
  margemPct      Float      @default(0)
  gramasPeca     Float
  custoPeca      Float
  gargalo        String     @default("")
  rolosLote      Int        @default(0)
  custoRolosLote Float      @default(0)
  resultado      Json
  outrosPerfis   Json       @default("[]")
  relatorio      String     @default("")
  impressos      Impresso[]

  @@index([criadoEm])
}

model Impresso {
  id            String      @id @default(cuid())
  criadoEm      DateTime    @default(now())
  quando        DateTime    @default(now())
  modelo        String
  link          String      @default("")
  escalaPct     Float       @default(100)
  quantidade    Int         @default(1) // pecas impressas (boas + perdidas)
  perdas        Int         @default(0) // pecas que falharam / sairam com defeito e nao da pra vender
  pecasPorPlaca Int         @default(1) // 1 = gramas e tempo sao de UMA peca; N = sao da placa inteira com N pecas
  gramas100     Float       @default(0) // gramas de filamento no tamanho original (100%), por peca ou por placa (ver pecasPorPlaca)
  precoRolo     Float       @default(0) // R$ do rolo usado na conta (0 = custoPeca foi digitado)
  pesoRoloG     Float       @default(0)
  custoPeca     Float       @default(0) // custo do material por peca (calculado ou digitado)
  outrosPeca    Float       @default(0)
  precoVenda    Float       @default(0)
  segundosPeca  Int         @default(0) // tempo de impressao, por peca ou por placa (ver pecasPorPlaca)
  obs           String      @default("")
  calculoId     String?
  calculo       Calculo?    @relation(fields: [calculoId], references: [id], onDelete: SetNull)
  movimentos    Movimento[]
  kitItens      KitItem[]

  @@index([quando])
}

// Lugar onde as pecas boas ficam (prateleira, loja, feira, consignado...).
model Local {
  id       String      @id @default(cuid())
  criadoEm DateTime    @default(now())
  nome     String
  obs      String      @default("")
  entradas Movimento[] @relation("para")
  saidas   Movimento[] @relation("de")
  kitItens KitItem[]
}

// Movimentacao de pecas boas de um lote. Local vazio (null) = "sem local":
// a peca acabou de sair da impressora e ainda nao foi levada pra lugar nenhum.
// O saldo de cada local e sempre recalculado somando os movimentos.
model Movimento {
  id          String   @id @default(cuid())
  quando      DateTime @default(now())
  quantidade  Int
  obs         String   @default("")
  impressoId  String
  impresso    Impresso @relation(fields: [impressoId], references: [id], onDelete: Cascade)
  deLocalId   String?
  de          Local?   @relation("de", fields: [deLocalId], references: [id], onDelete: Restrict)
  paraLocalId String?
  para        Local?   @relation("para", fields: [paraLocalId], references: [id], onDelete: Restrict)

  @@index([impressoId])
  @@index([quando])
}

// Produto montado com pecas boas de varios lotes (ex.: um suporte com 6
// chaveiros). As pecas que entram no kit saem do estoque; o que sobra do
// lote continua onde estava.
model Kit {
  id          String    @id @default(cuid())
  criadoEm    DateTime  @default(now())
  nome        String
  outrosCusto Float     @default(0) // argolas, embalagem... (R$ do kit inteiro)
  precoVenda  Float     @default(0)
  obs         String    @default("")
  itens       KitItem[]
}

// Pecas de um lote dentro de um kit. deLocalId diz de onde elas sairam
// (null = estavam "sem local"); um lote pode aparecer mais de uma vez no
// mesmo kit se as pecas vieram de lugares diferentes.
model KitItem {
  id         String   @id @default(cuid())
  quantidade Int
  kitId      String
  kit        Kit      @relation(fields: [kitId], references: [id], onDelete: Cascade)
  impressoId String
  impresso   Impresso @relation(fields: [impressoId], references: [id], onDelete: Cascade)
  deLocalId  String?
  de         Local?   @relation(fields: [deLocalId], references: [id], onDelete: Restrict)

  @@index([kitId])
  @@index([impressoId])
}
